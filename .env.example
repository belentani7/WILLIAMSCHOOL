# WILLIAMSCHOOL — variables para el servidor Express.
# No introduzcas secretos en el frontend ni subas .env a Git.
# El compañero utiliza Hugging Face; sin token funciona en modo local identificado.
HUGGINGFACE_TOKEN=""
COMPANION_MODEL="Qwen/Qwen2.5-7B-Instruct"

# Sólo las rutas heredadas /api/gemini/* usan Gemini.
# Dejar vacía la clave activa su respuesta local de demostración.
GEMINI_API_KEY=""

# Express utiliza el puerto proporcionado por el proveedor de hosting.
PORT="3000"
# URL pública opcional de la aplicación.
APP_URL=""
